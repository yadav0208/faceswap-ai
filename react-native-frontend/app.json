{
  "expo": {
    "name": "AI Catch",
    "slug": "faceswap-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "faceswapai",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.faceswapai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo for face swap",
        "NSPhotoLibraryUsageDescription": "Select a photo for face swap",
        "NSPhotoLibraryAddUsageDescription": "Save your generated looks"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D14"
      },
      "package": "com.faceswapai.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FaceSwap AI to access your photos.",
          "cameraPermission": "Allow FaceSwap AI to use the camera."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow FaceSwap AI to save photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
