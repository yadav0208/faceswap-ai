{
  "expo": {
    "name": "Anva AI",
    "slug": "anva-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "anvaai",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anvaai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo for AI generation",
        "NSPhotoLibraryUsageDescription": "Select a photo for AI generation",
        "NSPhotoLibraryAddUsageDescription": "Save your generated looks"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.anvaai.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Anva AI to access your photos.",
          "cameraPermission": "Allow Anva AI to use the camera."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Anva AI to save photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
