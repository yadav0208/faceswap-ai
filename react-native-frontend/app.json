{
  "expo": {
    "name": "Anva AI",
    "slug": "anva-ai",
    "version": "1.0.1",
    "orientation": "portrait",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/5662972b-9752-4edb-ba01-ff2fe08cdbe4"
    },
    "extra": {
      "apiUrl": "https://fortunate-empathy-production-07c6.up.railway.app",
      "eas": {
        "projectId": "5662972b-9752-4edb-ba01-ff2fe08cdbe4"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "icon": "./assets/anva-icon-v2.png",
    "userInterfaceStyle": "dark",
    "scheme": "anvaai",
    "splash": {
      "image": "./assets/anva-splash-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anvaai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo for AI generation",
        "NSPhotoLibraryUsageDescription": "Select a photo for AI generation",
        "NSPhotoLibraryAddUsageDescription": "Save your generated looks"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/anva-adaptive-v2.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.anvaai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/anva-favicon-v2.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Anva AI to access your photos.",
          "cameraPermission": "Allow Anva AI to use the camera."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Anva AI to save generated photos and videos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "pankaj11raos-team"
  }
}
