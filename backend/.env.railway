# Copy these into Railway → Your Service → Variables

APP_NAME=Anva AI
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# Database — Railway adds this automatically if you add a Postgres plugin
# For SQLite (ephemeral, resets on redeploy):
DATABASE_URL=sqlite+aiosqlite:///./faceswap.db

# Directories (relative paths inside the container)
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
POSE_TEMPLATES_DIR=pose_templates

# File upload limit (10 MB)
MAX_UPLOAD_SIZE=10485760

# Magic Hour — REQUIRED
MAGIC_HOUR_API_KEY=your_magic_hour_api_key_here
MAGIC_HOUR_IMAGE_MODEL=flux-schnell

# Provider config (Magic Hour only — no local models needed)
IMAGE_PROVIDER=magic_hour
FACE_SWAP_PROVIDER=magic_hour
USE_AI_MODELS=false
DEVICE=cpu

# Leave blank — not used when IMAGE_PROVIDER=magic_hour
HF_TOKEN=
GEMINI_API_KEY=

# CORS — allow all origins (restrict to your domain in production)
ALLOWED_ORIGINS=*

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
