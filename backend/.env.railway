# Railway backend variables.
# Copy these keys to Backend Service -> Variables. Keep actual secrets in Railway,
# never in this tracked file. Rename "MySQL" below if your DB service has another name.

APP_NAME=Anva AI
ENVIRONMENT=production
SECRET_KEY=<generate-with-openssl-rand-hex-32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Railway reference variable from the attached MySQL service.
DATABASE_URL=${{MySQL.MYSQL_URL}}

# Attach a Railway volume mounted at /data.
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs
POSE_TEMPLATES_DIR=/app/pose_templates
MAX_UPLOAD_SIZE=10485760

# Replace with the deployed frontend URL and this backend's Railway domain.
ALLOWED_ORIGINS=https://your-frontend-domain.example
TRUSTED_HOSTS=your-backend.up.railway.app
ENABLE_DOCS=false

IMAGE_PROVIDER=magic_hour
FACE_SWAP_PROVIDER=magic_hour
MAGIC_HOUR_API_KEY=<railway-secret>
MAGIC_HOUR_IMAGE_MODEL=flux-schnell
AI_REQUEST_TIMEOUT_SECONDS=300
