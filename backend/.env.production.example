APP_NAME=Anva AI
ENVIRONMENT=production
SECRET_KEY=generate-a-random-secret-with-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Use a managed MySQL service. Never use SQLite on an ephemeral production host.
DATABASE_URL=mysql+asyncmy://anva_user:strong-password@mysql-host:3306/anva_ai

# Mount persistent storage at /data in Railway or your container platform.
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs
POSE_TEMPLATES_DIR=/app/pose_templates
MAX_UPLOAD_SIZE=10485760

# Exact deployed web origins, comma-separated. Wildcards are rejected.
ALLOWED_ORIGINS=https://app.your-domain.com
TRUSTED_HOSTS=api.your-domain.com,your-service.up.railway.app
ENABLE_DOCS=false

IMAGE_PROVIDER=magic_hour
FACE_SWAP_PROVIDER=magic_hour
MAGIC_HOUR_API_KEY=replace-in-host-secret-manager
MAGIC_HOUR_IMAGE_MODEL=flux-schnell
AI_REQUEST_TIMEOUT_SECONDS=300
