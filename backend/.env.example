APP_NAME=Anva AI
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite+aiosqlite:///./faceswap.db
# Production MySQL example:
# DATABASE_URL=mysql+asyncmy://anva_user:strong-password@db-host:3306/anva_ai
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
POSE_TEMPLATES_DIR=pose_templates
MAX_UPLOAD_SIZE=10485760
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
TRUSTED_HOSTS=localhost,127.0.0.1
ENABLE_DOCS=true
IMAGE_PROVIDER=magic_hour
FACE_SWAP_PROVIDER=magic_hour
MAGIC_HOUR_API_KEY=
MAGIC_HOUR_IMAGE_MODEL=flux-schnell
OTP_EXPIRY_SECONDS=300
# Keep false outside local development. When true, the OTP is returned to the app.
OTP_DEVELOPMENT_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
